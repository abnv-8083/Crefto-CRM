NODE_ENV=production
PORT=5000

# MongoDB Atlas URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/crefto_crm?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=crefto_crm_super_secret_jwt_key_2024_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=crefto_crm_refresh_secret_2024_production
JWT_REFRESH_EXPIRE=30d

# Cookie
COOKIE_EXPIRE=30

# Nodemailer (SMTP) - Optional (for emailing credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=Crefto CRM
FROM_EMAIL=noreply@creftocrm.com

# Frontend URL (leave empty or set to your Vercel deployment URL)
FRONTEND_URL=
